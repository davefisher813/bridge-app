# Environment for a QA boot. qa/check.js reads this file directly.
#
# WHY THIS FILE EXISTS, checked before it was written: the built app does
# NOT exit when Supabase is unreachable. The session refresh asks Supabase
# who the visitor is, gets nobody, and sends every protected route to
# /login, which renders without a network call. So a QA boot is possible
# with nothing real in the environment, and this file only makes that boot
# deterministic instead of dependent on whatever happens to be exported in
# a shell.
#
# Every value here is a placeholder and is meant to be. Nothing in this
# file unlocks anything. The real values live in Vercel's environment
# variables and are never copied into the repo, a report, or a screenshot.

NODE_ENV=production
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:9
NEXT_PUBLIC_SUPABASE_ANON_KEY=qa-check-placeholder-anon-key-not-a-real-key
# Left deliberately empty so the owner-gated writes take their "not
# configured" path. The QA boot never writes anything.
SUPABASE_SERVICE_ROLE_KEY=
